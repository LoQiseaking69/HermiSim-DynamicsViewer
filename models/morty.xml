<?xml version="1.0"?>
<!--
  MORTY — bipedal humanoid for the HermiSim / Tulpa reimagining of the Morty project.
  16 body joints (5 per leg, 3 per arm) + 2 gripper slides, torque-controlled motors (N·m / N),
  IMU, joint pos/vel/torque, ankle force/torque, sole touch pads and wrist force sensors.
  Controller: workspace/morty (TulpaLang).  Masses ≈ 51 kg total, standing pelvis height ≈ 0.93 m.
-->
<mujoco model="morty">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <default>
    <joint type="hinge" damping="1.5" armature="0.12" limited="true"/>
    <geom condim="3" friction="1.0 0.05 0.005" solref="0.005 1"/>
    <motor ctrllimited="true"/>
  </default>
  <visual>
    <headlight ambient="0.35 0.35 0.4" diffuse="0.6 0.6 0.6"/>
    <map znear="0.01"/>
    <quality shadowsize="4096"/>
    <global offwidth="1280" offheight="720" azimuth="140" elevation="-15"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.04 0.06 0.10" rgb2="0.0 0.0 0.02" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.07 0.09 0.12" rgb2="0.05 0.06 0.08" mark="edge" markrgb="0.0 0.75 0.85" width="512" height="512"/>
    <material name="floor" texture="grid" texrepeat="10 10" reflectance="0.04"/>
    <material name="shell" rgba="0.80 0.84 0.90 1" specular="0.6" shininess="0.8"/>
    <material name="dark" rgba="0.12 0.13 0.16 1" specular="0.3"/>
    <material name="accent" rgba="0.0 0.85 0.95 1" emission="0.4"/>
    <material name="visor" rgba="0.55 0.2 0.95 1" emission="0.7"/>
  </asset>
  <worldbody>
    <light directional="true" diffuse="0.7 0.7 0.75" pos="0 0 6" dir="-0.3 -0.2 -1" castshadow="true"/>
    <light diffuse="0.3 0.35 0.5" pos="3 -3 4" dir="-1 1 -1"/>
    <geom name="ground" type="plane" size="20 20 0.1" material="floor" friction="1.2 0.02 0.002"/>
    <camera name="side" pos="0.3 -3.4 1.1" xyaxes="1 0 0 0 0.12 1"/>
    <camera name="front" pos="3.2 0.2 1.1" xyaxes="0 1 0 -0.12 0 1"/>
    <body name="pelvis" pos="0 0 0.935">
      <freejoint name="root"/>
      <geom name="pelvis_geom" type="box" size="0.09 0.14 0.06" mass="8" material="dark"/>
      <body name="torso" pos="0 0 0.08">
        <geom name="torso_geom" type="box" pos="0 0 0.17" size="0.10 0.16 0.17" mass="18" material="shell"/>
        <geom name="chest_core" type="cylinder" pos="0.101 0 0.2" zaxis="1 0 0" size="0.04 0.004" mass="0.05" material="accent" contype="0" conaffinity="0"/>
        <geom name="head" type="sphere" pos="0 0 0.45" size="0.095" mass="2.5" material="shell"/>
        <geom name="visor" type="box" pos="0.07 0 0.46" size="0.035 0.075 0.02" mass="0.05" material="visor" contype="0" conaffinity="0"/>
        <site name="imu" pos="0 0 0.1" size="0.015" rgba="1 0.2 0.8 1"/>
      <body name="left_upper_arm" pos="0 0.2 0.22">
        <joint name="left_shoulder_y" axis="0 1 0" range="-150 60"/>
        <joint name="left_shoulder_x" axis="1 0 0" range="-10 100"/>
        <geom name="left_upper_arm_geom" type="capsule" fromto="0 0 0 0 0 -0.27" size="0.04" mass="2" material="shell"/>
        <body name="left_forearm" pos="0 0 -0.27">
          <joint name="left_elbow" axis="0 1 0" range="-140 0"/>
          <geom name="left_forearm_geom" type="capsule" fromto="0 0 0 0 0 -0.25" size="0.035" mass="1.2" material="shell"/>
          <body name="left_hand" pos="0 0 -0.27">
            <site name="left_wrist_site" pos="0 0 0.02" size="0.01"/>
            <geom name="left_palm" type="box" size="0.03 0.015 0.04" mass="0.4" material="dark"/>
            <body name="left_finger" pos="0 0 -0.04">
              <joint name="left_grip" type="slide" axis="1 0 0" range="-0.025 0.025"/>
              <geom name="left_finger_geom" type="box" size="0.012 0.012 0.03" pos="0 0 -0.03" mass="0.1" material="accent"/>
            </body>
          </body>
        </body>
      </body>
      <body name="right_upper_arm" pos="0 -0.2 0.22">
        <joint name="right_shoulder_y" axis="0 1 0" range="-150 60"/>
        <joint name="right_shoulder_x" axis="1 0 0" range="-100 10"/>
        <geom name="right_upper_arm_geom" type="capsule" fromto="0 0 0 0 0 -0.27" size="0.04" mass="2" material="shell"/>
        <body name="right_forearm" pos="0 0 -0.27">
          <joint name="right_elbow" axis="0 1 0" range="-140 0"/>
          <geom name="right_forearm_geom" type="capsule" fromto="0 0 0 0 0 -0.25" size="0.035" mass="1.2" material="shell"/>
          <body name="right_hand" pos="0 0 -0.27">
            <site name="right_wrist_site" pos="0 0 0.02" size="0.01"/>
            <geom name="right_palm" type="box" size="0.03 0.015 0.04" mass="0.4" material="dark"/>
            <body name="right_finger" pos="0 0 -0.04">
              <joint name="right_grip" type="slide" axis="1 0 0" range="-0.025 0.025"/>
              <geom name="right_finger_geom" type="box" size="0.012 0.012 0.03" pos="0 0 -0.03" mass="0.1" material="accent"/>
            </body>
          </body>
        </body>
      </body>
      </body>
      <body name="left_thigh" pos="0 0.09 -0.08">
        <joint name="left_hip_x" axis="1 0 0" range="-30 30"/>
        <joint name="left_hip_y" axis="0 1 0" range="-110 40"/>
        <geom name="left_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.40" size="0.055" mass="5" material="shell"/>
        <body name="left_shin" pos="0 0 -0.40">
          <joint name="left_knee" axis="0 1 0" range="-2 140"/>
          <geom name="left_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.40" size="0.045" mass="3" material="shell"/>
          <geom name="left_knee_cap" type="sphere" size="0.05" mass="0.1" material="accent" contype="0" conaffinity="0"/>
          <body name="left_foot" pos="0 0 -0.40">
            <joint name="left_ankle_y" axis="0 1 0" range="-45 45"/>
            <joint name="left_ankle_x" axis="1 0 0" range="-25 25"/>
            <geom name="left_foot_geom" type="box" pos="0.03 0 -0.035" size="0.11 0.06 0.025" mass="1" material="dark" friction="1.2 0.02 0.002"/>
            <site name="left_ankle_site" pos="0 0 0" size="0.012" rgba="0 1 0.9 1"/>
            <site name="left_toe" pos="0.13 0 -0.06" size="0.012" rgba="0 1 0.9 0.6"/>
            <site name="left_heel" pos="-0.07 0 -0.06" size="0.012" rgba="0 1 0.9 0.6"/>
          </body>
        </body>
      </body>
      <body name="right_thigh" pos="0 -0.09 -0.08">
        <joint name="right_hip_x" axis="1 0 0" range="-30 30"/>
        <joint name="right_hip_y" axis="0 1 0" range="-110 40"/>
        <geom name="right_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.40" size="0.055" mass="5" material="shell"/>
        <body name="right_shin" pos="0 0 -0.40">
          <joint name="right_knee" axis="0 1 0" range="-2 140"/>
          <geom name="right_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.40" size="0.045" mass="3" material="shell"/>
          <geom name="right_knee_cap" type="sphere" size="0.05" mass="0.1" material="accent" contype="0" conaffinity="0"/>
          <body name="right_foot" pos="0 0 -0.40">
            <joint name="right_ankle_y" axis="0 1 0" range="-45 45"/>
            <joint name="right_ankle_x" axis="1 0 0" range="-25 25"/>
            <geom name="right_foot_geom" type="box" pos="0.03 0 -0.035" size="0.11 0.06 0.025" mass="1" material="dark" friction="1.2 0.02 0.002"/>
            <site name="right_ankle_site" pos="0 0 0" size="0.012" rgba="0 1 0.9 1"/>
            <site name="right_toe" pos="0.13 0 -0.06" size="0.012" rgba="0 1 0.9 0.6"/>
            <site name="right_heel" pos="-0.07 0 -0.06" size="0.012" rgba="0 1 0.9 0.6"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <exclude body1="pelvis" body2="left_thigh"/>
    <exclude body1="pelvis" body2="right_thigh"/>
    <exclude body1="torso" body2="left_upper_arm"/>
    <exclude body1="torso" body2="right_upper_arm"/>
  </contact>
  <actuator>
    <motor name="left_hip_x_motor" joint="left_hip_x" ctrlrange="-150 150"/>
    <motor name="left_hip_y_motor" joint="left_hip_y" ctrlrange="-200 200"/>
    <motor name="left_knee_motor" joint="left_knee" ctrlrange="-250 250"/>
    <motor name="left_ankle_y_motor" joint="left_ankle_y" ctrlrange="-120 120"/>
    <motor name="left_ankle_x_motor" joint="left_ankle_x" ctrlrange="-80 80"/>
    <motor name="right_hip_x_motor" joint="right_hip_x" ctrlrange="-150 150"/>
    <motor name="right_hip_y_motor" joint="right_hip_y" ctrlrange="-200 200"/>
    <motor name="right_knee_motor" joint="right_knee" ctrlrange="-250 250"/>
    <motor name="right_ankle_y_motor" joint="right_ankle_y" ctrlrange="-120 120"/>
    <motor name="right_ankle_x_motor" joint="right_ankle_x" ctrlrange="-80 80"/>
    <motor name="left_shoulder_y_motor" joint="left_shoulder_y" ctrlrange="-60 60"/>
    <motor name="left_shoulder_x_motor" joint="left_shoulder_x" ctrlrange="-60 60"/>
    <motor name="left_elbow_motor" joint="left_elbow" ctrlrange="-40 40"/>
    <motor name="right_shoulder_y_motor" joint="right_shoulder_y" ctrlrange="-60 60"/>
    <motor name="right_shoulder_x_motor" joint="right_shoulder_x" ctrlrange="-60 60"/>
    <motor name="right_elbow_motor" joint="right_elbow" ctrlrange="-40 40"/>
    <motor name="left_grip_motor" joint="left_grip" ctrlrange="-30 30"/>
    <motor name="right_grip_motor" joint="right_grip" ctrlrange="-30 30"/>
  </actuator>
  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_accel" site="imu"/>
    <framepos name="pelvis_pos" objtype="body" objname="pelvis"/>
    <framelinvel name="pelvis_vel" objtype="body" objname="pelvis"/>
    <jointpos name="left_hip_x_pos" joint="left_hip_x"/>
    <jointpos name="left_hip_y_pos" joint="left_hip_y"/>
    <jointpos name="left_knee_pos" joint="left_knee"/>
    <jointpos name="left_ankle_y_pos" joint="left_ankle_y"/>
    <jointpos name="left_ankle_x_pos" joint="left_ankle_x"/>
    <jointpos name="right_hip_x_pos" joint="right_hip_x"/>
    <jointpos name="right_hip_y_pos" joint="right_hip_y"/>
    <jointpos name="right_knee_pos" joint="right_knee"/>
    <jointpos name="right_ankle_y_pos" joint="right_ankle_y"/>
    <jointpos name="right_ankle_x_pos" joint="right_ankle_x"/>
    <jointpos name="left_shoulder_y_pos" joint="left_shoulder_y"/>
    <jointpos name="left_shoulder_x_pos" joint="left_shoulder_x"/>
    <jointpos name="left_elbow_pos" joint="left_elbow"/>
    <jointpos name="right_shoulder_y_pos" joint="right_shoulder_y"/>
    <jointpos name="right_shoulder_x_pos" joint="right_shoulder_x"/>
    <jointpos name="right_elbow_pos" joint="right_elbow"/>
    <jointpos name="left_grip_pos" joint="left_grip"/>
    <jointpos name="right_grip_pos" joint="right_grip"/>
    <jointvel name="left_hip_x_vel" joint="left_hip_x"/>
    <jointvel name="left_hip_y_vel" joint="left_hip_y"/>
    <jointvel name="left_knee_vel" joint="left_knee"/>
    <jointvel name="left_ankle_y_vel" joint="left_ankle_y"/>
    <jointvel name="left_ankle_x_vel" joint="left_ankle_x"/>
    <jointvel name="right_hip_x_vel" joint="right_hip_x"/>
    <jointvel name="right_hip_y_vel" joint="right_hip_y"/>
    <jointvel name="right_knee_vel" joint="right_knee"/>
    <jointvel name="right_ankle_y_vel" joint="right_ankle_y"/>
    <jointvel name="right_ankle_x_vel" joint="right_ankle_x"/>
    <jointvel name="left_shoulder_y_vel" joint="left_shoulder_y"/>
    <jointvel name="left_shoulder_x_vel" joint="left_shoulder_x"/>
    <jointvel name="left_elbow_vel" joint="left_elbow"/>
    <jointvel name="right_shoulder_y_vel" joint="right_shoulder_y"/>
    <jointvel name="right_shoulder_x_vel" joint="right_shoulder_x"/>
    <jointvel name="right_elbow_vel" joint="right_elbow"/>
    <jointvel name="left_grip_vel" joint="left_grip"/>
    <jointvel name="right_grip_vel" joint="right_grip"/>
    <actuatorfrc name="left_hip_x_trq" actuator="left_hip_x_motor"/>
    <actuatorfrc name="left_hip_y_trq" actuator="left_hip_y_motor"/>
    <actuatorfrc name="left_knee_trq" actuator="left_knee_motor"/>
    <actuatorfrc name="left_ankle_y_trq" actuator="left_ankle_y_motor"/>
    <actuatorfrc name="left_ankle_x_trq" actuator="left_ankle_x_motor"/>
    <actuatorfrc name="right_hip_x_trq" actuator="right_hip_x_motor"/>
    <actuatorfrc name="right_hip_y_trq" actuator="right_hip_y_motor"/>
    <actuatorfrc name="right_knee_trq" actuator="right_knee_motor"/>
    <actuatorfrc name="right_ankle_y_trq" actuator="right_ankle_y_motor"/>
    <actuatorfrc name="right_ankle_x_trq" actuator="right_ankle_x_motor"/>
    <actuatorfrc name="left_shoulder_y_trq" actuator="left_shoulder_y_motor"/>
    <actuatorfrc name="left_shoulder_x_trq" actuator="left_shoulder_x_motor"/>
    <actuatorfrc name="left_elbow_trq" actuator="left_elbow_motor"/>
    <actuatorfrc name="right_shoulder_y_trq" actuator="right_shoulder_y_motor"/>
    <actuatorfrc name="right_shoulder_x_trq" actuator="right_shoulder_x_motor"/>
    <actuatorfrc name="right_elbow_trq" actuator="right_elbow_motor"/>
    <force name="left_foot_force" site="left_ankle_site"/>
    <touch name="left_toe_touch" site="left_toe"/>
    <touch name="left_heel_touch" site="left_heel"/>
    <force name="right_foot_force" site="right_ankle_site"/>
    <touch name="right_toe_touch" site="right_toe"/>
    <touch name="right_heel_touch" site="right_heel"/>
    <force name="left_hand_force" site="left_wrist_site"/>
    <force name="right_hand_force" site="right_wrist_site"/>
  </sensor>
  <keyframe>
    <key name="stand" qpos="0 0 0.93 1 0 0 0  0.1 0.15 -0.3 0  0.1 -0.15 -0.3 0  0 -0.12 0.24 -0.12 0  0 -0.12 0.24 -0.12 0"/>
  </keyframe>
</mujoco>
