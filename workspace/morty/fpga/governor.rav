# Cycle-accurate RTL model of Morty's FPGA torque governor (std/rtl).
#
#   uart_rx ─► rx (8N1, mid-bit sampling) ─► core FSM ─► tx FIFO ─► tx (8N1) ─► uart_tx
#                                              │
#                                  watchdog ───┘  (forces zero torque if commands stop)
#
# Replaces the original Morty `uart_comm.v`, whose 10-bit baud counter could never reach its
# divisor of 10416 and whose TX/RX shared one counter. `div` is clocks per UART bit.

import "std/rtl"
from "protocol" import SYNC_CMD, SYNC_RSP, N_JOINTS, CMD_LEN, LIMITS, F_CRC, F_CLAMP, F_SLEW, F_WATCHDOG, crc8_step, slew_limits

struct UartRx {
    sim
    div: int
    rx                      # input wire (idle high)
    prefix: str = "rx"
    state = nil             # 0 idle, 1 start, 2 data, 3 stop
    count = nil
    bitn = nil
    shift = nil
    data = nil
    valid = nil
    ferr = nil
    fn init(self) {
        self.state = self.sim.reg(self.prefix + ".state", 2)
        self.count = self.sim.reg(self.prefix + ".count", 16)
        self.bitn = self.sim.reg(self.prefix + ".bitn", 4)
        self.shift = self.sim.reg(self.prefix + ".shift", 8)
        self.data = self.sim.reg(self.prefix + ".data", 8)
        self.valid = self.sim.reg(self.prefix + ".valid")
        self.ferr = self.sim.reg(self.prefix + ".frame_err")
    }
    fn comb(self) {}
    fn seq(self) {
        let s = self.state.value
        let c = self.count.value
        self.valid.d(0)
        if s == 0 {
            if self.rx.value == 0 { self.state.d(1); self.count.d(0) }
        } elif s == 1 {
            if c == self.div / 2 - 1 {                 # middle of the start bit
                if self.rx.value == 0 { self.state.d(2); self.count.d(0); self.bitn.d(0) }
                else { self.state.d(0) }               # glitch
            } else { self.count.d(c + 1) }
        } elif s == 2 {
            if c == self.div - 1 {
                self.count.d(0)
                self.shift.d((self.shift.value >> 1) | (self.rx.value << 7))
                if self.bitn.value == 7 { self.state.d(3) } else { self.bitn.d(self.bitn.value + 1) }
            } else { self.count.d(c + 1) }
        } else {
            if c == self.div - 1 {
                self.state.d(0); self.count.d(0)
                if self.rx.value == 1 { self.data.d(self.shift.value); self.valid.d(1); self.ferr.d(0) }
                else { self.ferr.d(1) }
            } else { self.count.d(c + 1) }
        }
    }
}

struct UartTx {
    sim
    div: int
    fifo
    tx = nil
    busy = nil
    count = nil
    bitn = nil
    shift = nil
    state = nil             # 0 idle, 1 start, 2 data, 3 stop
    fn init(self) {
        self.tx = self.sim.reg("tx.line", 1, 1)
        self.busy = self.sim.sig("tx.busy")
        self.count = self.sim.reg("tx.count", 16)
        self.bitn = self.sim.reg("tx.bitn", 4)
        self.shift = self.sim.reg("tx.shift", 8)
        self.state = self.sim.reg("tx.state", 2)
    }
    fn comb(self) { self.busy.set(if self.state.value != 0 { 1 } else { 0 }) }
    fn seq(self) {
        let s = self.state.value
        let c = self.count.value
        if s == 0 {
            if not self.fifo.empty() {
                self.shift.d(self.fifo.pop()); self.state.d(1); self.count.d(0); self.tx.d(0)
            }
        } elif c < self.div - 1 {
            self.count.d(c + 1)
        } elif s == 1 {
            self.count.d(0); self.state.d(2); self.bitn.d(0); self.tx.d(self.shift.value & 1)
        } elif s == 2 {
            self.count.d(0)
            if self.bitn.value == 7 { self.state.d(3); self.tx.d(1) }
            else {
                self.bitn.d(self.bitn.value + 1)
                self.tx.d((self.shift.value >> (self.bitn.value + 1)) & 1)
            }
        } else {
            self.count.d(0); self.state.d(0)
        }
    }
}

struct GovernorCore {
    sim
    rx
    fifo
    wd_limit: int
    state = nil             # 0 sync, 1 seq, 2 data, 3 crc
    idx = nil
    crc = nil
    seqno = nil
    flags = nil
    wd = nil
    tripped = nil
    packets = nil
    buf = []                # 36-byte receive register file
    prev = []               # governed torque register file (int16 counts)
    fn init(self) {
        self.state = self.sim.reg("core.state", 2)
        self.idx = self.sim.reg("core.idx", 6)
        self.crc = self.sim.reg("core.crc", 8)
        self.seqno = self.sim.reg("core.seq", 8)
        self.flags = self.sim.reg("core.flags", 4)
        self.wd = self.sim.reg("core.watchdog", 24)
        self.tripped = self.sim.reg("core.tripped")
        self.packets = self.sim.reg("core.packets", 16)
        self.buf = [0; 2 * N_JOINTS]
        self.prev = [0; N_JOINTS]
    }
    fn comb(self) {}
    fn _respond(self, seq, flags) {
        let body = [seq] + pack::pack(f"<{N_JOINTS}h", self.prev) + [flags]
        let c = 0
        for b in body { c = crc8_step(c, b) }
        self.fifo.push(SYNC_RSP)
        for b in body { self.fifo.push(b) }
        self.fifo.push(c)
    }
    fn seq(self) {
        # watchdog
        if self.wd.value >= self.wd_limit {
            if self.tripped.value == 0 { self.prev = [0; N_JOINTS] }
            self.tripped.d(1)
        } else { self.wd.d(self.wd.value + 1) }
        if self.rx.valid.value == 0 { return nil }
        let b = self.rx.data.value
        let s = self.state.value
        if s == 0 {
            if b == SYNC_CMD { self.state.d(1); self.crc.d(0) }
        } elif s == 1 {
            self.seqno.d(b); self.crc.d(crc8_step(0, b)); self.idx.d(0); self.state.d(2)
        } elif s == 2 {
            self.buf[self.idx.value] = b
            self.crc.d(crc8_step(self.crc.value, b))
            if self.idx.value == 2 * N_JOINTS - 1 { self.state.d(3) } else { self.idx.d(self.idx.value + 1) }
        } else {
            self.state.d(0)
            let flags = if self.tripped.value == 1 { F_WATCHDOG } else { 0 }
            if b != self.crc.value {
                flags = flags | F_CRC
            } else {
                self.wd.d(0); self.tripped.d(0); self.packets.d(self.packets.value + 1)
                let slew = slew_limits()
                for i in 0..N_JOINTS {
                    let v = rtl.signed(self.buf[2 * i] | (self.buf[2 * i + 1] << 8), 16)
                    if v > LIMITS[i] { v = LIMITS[i]; flags = flags | F_CLAMP }
                    if v < -LIMITS[i] { v = -LIMITS[i]; flags = flags | F_CLAMP }
                    let d = v - self.prev[i]
                    if d > slew[i] { v = self.prev[i] + slew[i]; flags = flags | F_SLEW }
                    if d < -slew[i] { v = self.prev[i] - slew[i]; flags = flags | F_SLEW }
                    self.prev[i] = v
                }
            }
            self.flags.d(flags)
            self._respond(self.seqno.value, flags)
        }
    }
}

# Wires the whole governor into `sim`; returns handles for the testbench.
fn build(sim, div = 8, wd_limit = 200000) {
    let rx_line = sim.sig("uart_rx", 1, 1)
    let fifo = rtl.Fifo(depth: 64)
    let rx = sim.add(UartRx(sim: sim, div: div, rx: rx_line))
    let core = sim.add(GovernorCore(sim: sim, rx: rx, fifo: fifo, wd_limit: wd_limit))
    let tx = sim.add(UartTx(sim: sim, div: div, fifo: fifo))
    {rx_line: rx_line, rx: rx, core: core, tx: tx, fifo: fifo}
}
