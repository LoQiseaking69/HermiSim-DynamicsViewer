# Runtime state (persisted between sessions)
.state/

# Python
__pycache__/
*.pyc
*.pyo

# Logs
hermisim.log
hermisim.log.*

# Virtual environment
.venv/

# Build outputs (PyInstaller / Inno Setup)
build/
dist/

# Generated by running the Morty project
workspace/*/out/*
!workspace/*/out/.gitkeep
workspace/*/weights/*
!workspace/*/weights/.gitkeep
